# Runtruck — local development environment.
# Copy to `.env` (git-ignored) and adjust. These are throwaway local values for the
# docker-compose services in infrastructure/docker — never staging or production
# credentials (architecture §33, §34).

NODE_ENV=development

# PostgreSQL (source of truth) and Redis (queues, rate limits)
DATABASE_URL=postgres://runtruck:runtruck_dev@localhost:5432/runtruck
TEST_DATABASE_URL=postgres://runtruck:runtruck_dev@localhost:5432/runtruck_test
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=12
LOG_LEVEL=info

# Pins the business date for the Runtruck1 demo dataset. Remove to use the real
# date. Refused when NODE_ENV=production.
DEMO_TODAY=2026-09-03

# Object storage for documents (SeaweedFS locally via docker compose; any S3-compatible store elsewhere)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=runtruck-documents
S3_ACCESS_KEY_ID=runtruck
S3_SECRET_ACCESS_KEY=runtruck_dev_secret
S3_FORCE_PATH_STYLE=true

# Web (Next.js server-side proxy target for /api/v1)
API_ORIGIN=http://localhost:4000

# Password given to the seeded demo accounts by `pnpm db:seed` (development only;
# the seed refuses to run when NODE_ENV=production).
SEED_DEMO_PASSWORD=runtruck-demo-2026

# End-to-end tests (tests/e2e, `pnpm test:e2e`). Optional: by default they use the
# `runtruck_e2e` database next to DATABASE_URL and a fixed test-only password.
# E2E_DATABASE_URL=postgres://runtruck:runtruck_dev@localhost:5432/runtruck_e2e
# E2E_PASSWORD=e2e-password-not-a-secret
