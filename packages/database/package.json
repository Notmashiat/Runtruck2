{
  "name": "@runtruck/database",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle), migrations, client and seed — the source of truth (architecture §2 Rule 1, §7).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./seed": {
      "types": "./dist/seed/index.d.ts",
      "import": "./dist/seed/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/scripts/seed.js",
    "db:reset": "node --env-file-if-exists=../../.env dist/scripts/reset.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@runtruck/calculations": "workspace:*",
    "@runtruck/config": "workspace:*",
    "@runtruck/permissions": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@runtruck/eslint-config": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
